{
  "listen": [
    {
      "address": ":6437"
    }
  ],
  "routes": [
    {
      "match": {
        "matcher": "database",
        "database": "testdb"
      },
      "handle": {
        "handler": "pool",
        "pool": {
          "pool": "hybrid",
          "client_acquire_timeout": 10000000000,
          "server_idle_timeout": 60000000000,
          "server_reconnect_initial_time": 10000000,
          "server_reconnect_max_time": 1000000000,
          "tracked_parameters": [
            "client_encoding",
            "datestyle",
            "timezone",
            "standard_conforming_strings",
            "application_name",
            "intervalstyle",
            "search_path"
          ]
        },
        "recipe": {
          "address": "postgres-primary:5432",
          "ssl_mode": "disable",
          "ssl": {
            "provider": "insecure_skip_verify"
          },
          "username": "postgres",
          "password": "postgres",
          "database": "testdb",
          "min_connections": 1,
          "max_connections": 1
        }
      }
    }
  ]
}
