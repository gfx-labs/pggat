# Hybrid pooling: writes go to the primary pool, reads to the replica pool.
# Replica recipes are added by discovery. With a static address only the
# primary is configured, so reads fall back to it.

:6434 {
	pool /testdb {
		pool hybrid {
			idle_timeout 300s
		}

		address postgres-primary:5432
		ssl disable insecure_skip_verify

		username postgres
		password postgres
		database testdb
	}
}
