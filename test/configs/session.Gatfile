# Session pooling: each client session gets a dedicated server connection.

:6433 {
	pool /testdb {
		pool basic session {
			idle_timeout 300s
			reset_query "DISCARD ALL"
			reset_query_timeout 15s
		}

		address postgres-primary:5432
		ssl disable insecure_skip_verify

		username postgres
		password postgres
		database testdb
	}
}
