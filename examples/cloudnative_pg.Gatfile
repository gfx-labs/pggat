# Example: discover CloudNativePG clusters and pool them.
# Each discovered cluster gets a hybrid pool: writes go to the -rw service,
# reads are balanced across the -ro service.

:5433 {
	ssl self_signed

	discovery {
		discoverer cloudnative_pg {
			# only clusters in namespaces with these labels
			namespace default {
				label environment production
				label tier database
			}

			cluster_domain cluster.local
			read_write_service_suffix -rw
			read_only_service_suffix -ro
			port 5432

			# credentials are read from <cluster><secret_suffix>
			secret_suffix -app
			include_superuser false
		}

		reconcile_period 30s
		min_connections 0
		max_connections 50

		pool hybrid {
			idle_timeout 5m
			penalize replication_latency
		}

		ssl prefer insecure_skip_verify
	}
}
